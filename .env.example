# Google Gemini API Key for AI Insights & Natural Language Analytics
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# YouTube Data API v3 Key for fetching real trending music video stats
# Get your key from Google Cloud Console: https://console.cloud.google.com/
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY"

# Development server URL
APP_URL="http://localhost:3000"

# Optional: FastAPI Backend URL (default: http://127.0.0.1:8000 if running backend separately)
FASTAPI_URL="http://127.0.0.1:8000"
